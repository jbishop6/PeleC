# ------------------ INPUTS TO MAIN PROGRAM -------------------
#max_step = 100000000
#stop_time = 4e-6
cvode.dt_min = 1e-18
ode.rtol = 1e-5
ode.atol = 1e-4
#pelec.fixed_dt = 1e-10

#max_step = 10
#stop_time = 1e-10

#pelec.fixed_dt = 1e-11

max_step = 1000
stop_time = 1e-6

# I would initially let CFL control dt instead of forcing 1e-11
# pelec.fixed_dt = 1e-11

# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
#geometry.prob_hi     = 1.0  2.0   #0.125
#geometry.use_h = 0
#amr.n_cell           = 512  1024 #64

geometry.prob_lo = 0.0 0.0
geometry.prob_hi = 0.12 0.08

amr.n_cell = 192 128

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "FOExtrap" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.do_react     = 1

pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

pelec.chem_integrator = ReactorCvode

# -------------------PROB SPECIFIC -------------------
prob.idir  = 1
prob.frac  = 0.5
prob.T_l   = 3000.0

prob.p_l   = 1e7
prob.u_l   = 1e4
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4

prob.left_gas  = N2
prob.right_gas = He

# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int  = 25

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 1000
#amr.plot_int = -1

# put vfrac in plot_vars (not derive) so it is guaranteed to appear
amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort

# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1

eb2.build_type = all
eb2.max_coarsening_level = 0
eb2.geom_type = threebranch_newconfig

# same params the rotated_box uses 
eb2.box_lo = 0.40 0.03
eb2.box_hi = 0.60 0.09
eb2.box_has_fluid_inside = 0
eb2.box_rotation = 0
eb2.box_rotation_axe = 2

# THREE BRANCH GEOMETRY KNOBS
threebranch_newconfig.X = 0.100
threebranch_newconfig.Y = 0.050
threebranch_newconfig.L = 0.015
threebranch_newconfig.H = 0.030
threebranch_newconfig.W = 0.010
threebranch_newconfig.Z = 0.030
