# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step  = 1
stop_time = 1.0e-30


# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0
geometry.prob_hi     = 1.0  2.0
amr.n_cell           = 512  1024

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

# Disable reactions entirely
chem_integrator = none
do_react = 0
use_reactions = false

# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20
cvode.dt_min      = 1e-30
pelec.fixed_dt    = 1e-30     # tiny dt so it exits instantly


# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 1      # WRITE IMMEDIATELY

amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort


# ------------------ PROBLEM PARAMETERS -------------------
prob.p_l   = 1e7
prob.u_l   = 0.0
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4
prob.idir  = 1
prob.frac  = 0.5
prob.left_gas  = H2
prob.right_gas = O2


# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1

eb2.build_type            = all
eb2.max_coarsening_level  = 0
eb2.geom_type             = twobranch

# ---- Two-branch geometry knobs (domain units) ----
# H   = TOTAL height (red arrow in Fig. 2)
# mid = separator thickness
# L   (optional) = channel height; omit if you don't care

geo.H   = 1.0      # match the H in your timing figure
geo.mid = 0.1      # pick the separator thickness you want
# geo.L = 0.2      # OPTIONAL; leave this line out if you don't care about L
geo.X   = 0.4
geo.xs  = 0.30
geo.cL  = 0.05
geo.cR  = 0.05
