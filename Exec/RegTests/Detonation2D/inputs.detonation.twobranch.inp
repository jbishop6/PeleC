# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step = 100000000
stop_time = 2.7e-6

# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0
geometry.prob_hi     = 1.0  2.0
amr.n_cell           = 512  1024

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

# --- Enable Detonation Chemistry ---
#pelec.do_react = 1
#pelec.chem_integrator = "ReactorCvode"
#pelec.use_typ_vals_chem = 1
#cvode.solve_type = "denseAJ_direct"
#ode.rtol = 1.0e-6
#ode.atol = 1.0e-5
#pelec.fixed_dt = 1e-10

# Disable reactions entirely
chem_integrator = none
do_react = 0
# Optional but recommended to ensure no chemistry source terms
use_reactions = false

# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20
cvode.dt_min = 1e-18
pelec.fixed_dt = 1e-10


# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int  = 100

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 1000
# put vfrac in plot_vars (not derive) so it is guaranteed to appear
amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort

# ------------------ PROBLEM PARAMETERS -------------------
prob.p_l   = 1e7
prob.u_l   = 0.0
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4
prob.idir  = 1
prob.frac  = 0.5
prob.left_gas  = H2
prob.right_gas = O2


# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1

# Use your new factory-registered geometry: TwoBranch::identifier() == "twobranch"
eb2.build_type            = all
eb2.max_coarsening_level  = 0
eb2.geom_type             = twobranch

# ---- Two-branch geometry knobs (domain units) ----
# L = channel height (upper & lower branches)  <-- controls inlet/outlet thickness
# H = center wall thickness
# X = horizontal length of the two-branch region
# xs = x-position of the left edge of the two-branch region
# cL, cR = how much of the mid-wall you "trim" on the left/right to open the channels

geo.L        = 0.0390625   # match three-branch channel height
geo.H        = 0.10        # match three-branch separator thickness
geo.X        = 0.40        # match three-branch channel length
geo.xs       = 0.30        # left edge
geo.cL       = 0.05        # same trims as three-branch
geo.cR       = 0.05
geo.y_offset = 0.0
