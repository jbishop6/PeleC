# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step = 10000
stop_time = 1.959e-6

# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0           # 0 => Cartesian
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 1.0  0.125
amr.n_cell           = 512  64

# ------------------ BOUNDARY CONDITIONS -------------------
# Interior, UserBC, Symmetry, SlipWall, NoSlipWall
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.do_react     = 0

# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int  = 100

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt         # keep fixed while debugging
amr.plot_int          = 1
amr.plot_vars         = density Temp
amr.derive_plot_vars  = vfrac pressure x_velocity y_velocity magvel magvort

# ------------------ PROBLEM PARAMETERS (simple left/right) -------------------
prob.p_l   = 1e7
prob.u_l   = 0.0
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4
prob.idir  = 1
prob.frac  = 0.5
prob.left_gas  = N2
prob.right_gas = HE

# ------------------ EMBEDDED BOUNDARY (EB) -------------------
# Force EB codepath on, and use a built-in box so we *see* a cut.
pelec.eb_in_domain = 1

eb2.geom_type = box               # built-in AMReX EB (no custom factory needed)
eb2.box_lo = 0.40 0.03
eb2.box_hi = 0.60 0.09
eb2.box_has_fluid_inside = 0      # inside the box is SOLID

eb2.max_coarsening_level = 0
