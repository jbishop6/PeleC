# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step = 10000
stop_time = 1.959e-6

# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
geometry.prob_hi     = 1.0  1.0  # 1.0
amr.n_cell           = 1024 1024 #1024

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0
pelec.do_react     = 0

# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int  = 100

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 100
amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort

# ------------------ PROBLEM PARAMETERS -------------------
prob.p_l   = 1e7
prob.u_l   = 0.0
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4
prob.idir  = 1
prob.frac  = 0.5
prob.left_gas  = N2
prob.right_gas = HE

# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1
ebd.boundary_grad_stencil_type = 1  # ghost nodes

eb2.build_type = all
eb2.max_coarsening_level = 0
eb2.geom_type = threebranch

# ThreeBranch geometry parameters
geo.W        = 0.041015625
geo.H        = 0.0390625
geo.L        = 0.0390625
geo.Z        = 0.08

geo.xs       = 0.30
geo.xr       = 0.70
geo.mid      = 0.025390625
geo.y_offset = 0.0

geo.cL = 0.02   # left-side mid-wall retraction
geo.cR = 0.02   # right-side mid-wall retraction

geo.Z = 0.08     # Height of the third branch (vertical)
geo.zW = 0.005   # Wall thickness of third branch
