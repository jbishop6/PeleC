# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step = 100000000
stop_time = 4e-6
cvode.dt_min = 1e-18
ode.rtol = 1e-5
ode.atol = 1e-4
pelec.fixed_dt = 1e-10

# ------------------ GEOMETRY (1D) -------------------
geometry.is_periodic = 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0
geometry.prob_hi     = 1.0
amr.n_cell           = 512

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "FOExtrap" "SlipWall"
pelec.hi_bc = "FOExtrap" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

# ------------------ DETONATION WAVE ------------------
pelec.do_react = 0
ode.rtol = 1.0e-6
ode.atol = 1.0e-5

pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall"  "SlipWall"

prob.idir  = 1
prob.frac  = 0.5
prob.T_l   = 3000.0

prob.p_l   = 1e7
prob.u_l   = 1e4
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4

prob.left_gas  = N2
prob.right_gas = N2


# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall"  "SlipWall"

# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 0
amr.blocking_factor = 8
amr.max_grid_size   = 128
amr.n_error_buf     = 2

# ------------------ CHECKPOINT FILES -------------------
amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int  = 100

# ------------------ PLOTFILES -------------------
amr.plot_files_output = 1
amr.plot_file         = plt
amr.plot_int          = 1000
#amr.plot_int = -1
# put vfrac in plot_vars (not derive) so it is guaranteed to appear
amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort

# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1
