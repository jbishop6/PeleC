# ----------------------------
# DOMAIN CONFIG
geometry.is_periodic = 0 0 0
amr.n_cell = 512 1 1
geometry.prob_lo = 0.0 0.0 0.0
geometry.prob_hi = 1.0 0.01 0.01

# ----------------------------
# TIME CONTROL
max_step = 3000
pelec.dt = 1.0e-9
stop_time = 5e-5

# ----------------------------
# CHEMISTRY
pelec.do_react = 1
pelec.reactions_type = 1

# ----------------------------
# OUTPUT
amr.plot_int = 100
amr.plot_file = detonation1d
amr.check_int = 500
amr.check_file = chk_detonation1d

# ----------------------------
# BOUNDARY CONDITIONS
boundary.lo = Reflect_Even Symmetry Symmetry
boundary.hi = Outflow      Symmetry Symmetry

# ----------------------------
# INIT
use_exact_init = true
