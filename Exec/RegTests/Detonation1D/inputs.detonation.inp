# -------- Geometry (1-D in practice) --------
geometry.coord_sys    = 0
geometry.prob_lo      = 0.0   0.0  0.0
geometry.prob_hi      = 1.0   1.0  1.0
geometry.is_periodic  = 0     1    1      # 1-D: only x has non-periodic BCs

# -------- Grid --------
amr.n_cell            = 800   1    1      # 1-D line
amr.max_level         = 0
amr.blocking_factor   = 8
amr.max_grid_size     = 256

# -------- Time stepping --------
max_step              = 2000
stop_time             = 0.002
cfl                   = 0.8
init_shrink           = 0.1
grow_cfl              = 1.1

# -------- I/O --------
amr.plot_file         = plt_det1d
amr.plot_int          = 50
amr.check_file        = chk_det1d
amr.check_int         = 0

# -------- Physics toggles (build uses GammaLaw/Null/Constant) --------
pelec.do_hydro        = 1
pelec.do_react        = 0
pelec.do_diffuse      = 0

# -------- Gamma-law EOS params (compile-time model = GammaLaw) --------
eos.gamma             = 1.4
eos.R_gas             = 287.0    # only used if your prob.cpp expects it

# -------- Problem ICs (match names your prob.cpp expects!) --------
# Typical Sod left/right states; adjust names if your Sod file uses different keys
prob.rho_left         = 1.0
prob.u_left           = 0.0
prob.p_left           = 1.0

prob.rho_right        = 0.125
prob.u_right          = 0.0
prob.p_right          = 0.1

prob.xshock           = 0.5      # diaphragm position (in x)
