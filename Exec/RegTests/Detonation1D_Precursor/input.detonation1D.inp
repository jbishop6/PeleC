
# ============================================================
# ETHYLENE-AIR DETONATION PROPAGATION
# Baurle-Eklund mechanism
# Quasi-1D PeleC simulation
# ============================================================

# ------------------ TIME CONTROL ------------------

max_step = 5000000
stop_time = 5.e-5
pelec.fixed_dt = 1.e-11

pelec.cfl         = 0.5
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.0e-20


# ------------------ CHEMISTRY SOLVER ------------------

cvode.dt_min = 1.0e-18
cvode.solve_type = dense_direct
ode.rtol = 1.0e-6
ode.atol = 1.0e-10

transport.const_thermal_diffusion_ratio = 0
transport.use_soret = 0


# ------------------ GEOMETRY ------------------

geometry.coord_sys = 0

geometry.is_periodic = 0 1

geometry.prob_lo = 0.0  0.0
geometry.prob_hi = 10.0 0.2

# 50 micron x-resolution
amr.n_cell = 2000 8


# ------------------ BOUNDARY CONDITIONS ------------------

pelec.lo_bc = "FOExtrap" "Interior"
pelec.hi_bc = "FOExtrap" "Interior"


# ------------------ PHYSICS ------------------

pelec.do_hydro = 1
pelec.do_react = 1

pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

pelec.chem_integrator = ReactorCvode


# ------------------ PROBLEM INITIAL CONDITIONS ------------------

# Unburned ethylene-air mixture
# These values are placeholders pending verification
# of prob.cpp and prob.H initialization.

prob.T_r = 300.0
prob.p_r = 1.0e6
prob.u_r = 0.0

# Left-side driver state and species composition
# must be verified in prob.cpp/prob.H before running.


# ------------------ AMR / GRID ------------------

amr.max_level = 0

amr.blocking_factor = 8
amr.max_grid_size = 256
amr.n_error_buf = 2


# ------------------ VERBOSITY ------------------

pelec.v = 1
amr.v = 1

amr.data_log = datlog


# ------------------ CHECKPOINTS ------------------

amr.checkpoint_files_output = 0
amr.check_file = chk
amr.check_int = 1000


# ------------------ PLOTFILES ------------------

amr.plot_files_output = 1
amr.plot_file = plt

amr.plot_int = 1000

amr.plot_vars = density Temp
amr.derive_plot_vars = pressure x_velocity
