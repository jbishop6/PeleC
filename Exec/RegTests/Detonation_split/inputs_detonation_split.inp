# geo.W = 0.1 # Thickness of the third branch

# MQ set input
geo.W = 0.05
geo.H = 0.1
geo.L = 0.15
geo.xs = 0.05;
geo.X = 0.40;
geo.mid = 0.02;
geo.cL  = 0.05;
geo.cR  = 0.05;
geo.y_offset = 0.15;
geo.Z = 0.15;

