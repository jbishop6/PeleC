# ------------------ INPUTS TO MAIN PROGRAM -------------------
max_step = 100000000
stop_time = 5.0e-6
pelec.fixed_dt = 1e-9

# ------------------ Outputs (regular or high-speed) -----
# PLOT FILES
amr.plot_files_output = 1
# amr.plot_file = /home/XXXX...XXXX/output/plt
amr.plot_file = ./output/plt
# amr.plot_file = /mmfs1/home/jquinlan/runs/temp/plt
amr.plot_int          = 100

# CHECKPOINT FILES
amr.checkpoint_files_output = 0
amr.check_file      = ./output/chk        # root name of checkpoint file
amr.check_int       = 200        # number of timesteps between checkpoints

# ------------------ GEOMETRY (2D) -------------------
geometry.is_periodic = 0 0
geometry.coord_sys   = 0
geometry.prob_lo     = 0.0  0.0
# geometry.prob_hi     = 1.0  2.0   #0.125
geometry.prob_hi     = 0.8  0.8   #0.125
geometry.use_h = 0
# amr.n_cell           = 512  1024 #64
# amr.n_cell           = 256 256 #64
amr.n_cell           = 512 512 #64

# ------------------ BOUNDARY CONDITIONS -------------------
pelec.lo_bc = "SlipWall" "SlipWall"
pelec.hi_bc = "SlipWall" "SlipWall"

# ------------------ PHYSICS -------------------
pelec.do_hydro     = 1
pelec.diffuse_vel  = 0
pelec.diffuse_temp = 0
pelec.diffuse_spec = 0

# ------------------ DETONATION WAVE ------------------
pelec.do_react = 0
# pelec.chem_integrator = "ReactorCvode"
# pelec.use_typ_vals_chem = 1
# cvode.solve_type = "denseAJ_direct"
# ode.rtol = 1.0e-6
# ode.atol = 1.0e-5



prob.idir  = 0
# prob.frac  = 0.02
# prob.rho_l = 1.2
# prob.T_l   = 3000.0
# 
# prob.p_l   = 5e6
# prob.u_l   = 5000.0
# prob.rho_l = 5e-4
# 
# prob.p_r   = 1e6
# prob.u_r   = 0.0
# prob.rho_r = 1e-4
# 
# prob.left_gas  = H2
# prob.right_gas = O2



# ------------------ TIME STEP CONTROL -------------------
pelec.cfl         = 0.9
pelec.init_shrink = 0.1
pelec.change_max  = 1.05
pelec.dt_cutoff   = 5.e-20

# ------------------ DIAGNOSTICS & VERBOSITY -------------------
pelec.v      = 1
amr.v        = 1
amr.data_log = datlog

# ------------------ REFINEMENT / GRIDS -------------------
amr.max_level       = 1
amr.ref_ratio       = 2 2 2 2 # refinement ratio
amr.regrid_int      = 2       # how often to regrid
amr.blocking_factor = 16 16      # block factor in grid generation
amr.max_grid_size   = 32
amr.n_error_buf     = 12 8 2 2


# ------------------ PLOTFILES vars -------------------

# put vfrac in plot_vars (not derive) so it is guaranteed to appear
amr.plot_vars         = vfrac density Temp
amr.derive_plot_vars  = pressure x_velocity y_velocity magvel magvort
# amr.derive_plot_vars = ALL



# ----------------- TAGGING -----------------------------
#tagging.denerr = 3
#tagging.dengrad = 0.01
#tagging.max_denerr_lev = 3
#tagging.max_dengrad_lev = 3
#tagging.presserr = 3
#tagging.pressgrad = 0.01
#tagging.max_presserr_lev = 3
#tagging.max_pressgrad_lev = 3

tagging.max_dengrad_lev = 5
tagging.dengrad = 2.e-4
tagging.max_vorterr_lev = 5
tagging.vorterr = 100



# ------------------ PROBLEM PARAMETERS -------------------
prob.p_l   = 1e7
prob.u_l   = 1e4
prob.rho_l = 9.6e-4
prob.p_r   = 1e6
prob.u_r   = 0.0
prob.rho_r = 1.2e-4
prob.idir  = 1
prob.frac  = 0.04
prob.left_gas  = N2
prob.right_gas = HE

# ------------------ EMBEDDED BOUNDARY (EB) -------------------
pelec.eb_in_domain = 1

eb2.build_type = all
eb2.max_coarsening_level = 0
eb2.geom_type = threebranch




