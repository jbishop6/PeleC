# =======================
# Basic PeleC Box Example
# =======================
 
# Time stepping
max_step = 10          # Number of timesteps
stop_time = 0.01       # Maximum simulation time
 
# Grid size
amr.n_cell = 32 32 32  # Number of cells in x, y, z
amr.max_level = 0      # No AMR refinement
 
# Domain
prob.lo = 0.0 0.0 0.0  # Lower coordinates (x,y,z)
prob.hi = 1.0 1.0 1.0  # Upper coordinates (x,y,z)
 
# Physics
prob.type = box         # This tells PeleC it’s a simple box domain
